{
  "name": "roviq",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:unit": "vitest run --project unit-node --project unit-dom",
    "test:int": "nx run integration-tests:test:int",
    "test:e2e:api": ". scripts/instance-env.sh && pnpm e2e:up && nx run api-gateway-e2e:test-e2e",
    "test:e2e:ui": ". scripts/instance-env.sh && pnpm e2e:up && fuser -k ${E2E_WEB_PORT:-4201}/tcp 2>/dev/null; NEXT_PUBLIC_API_URL=http://localhost:${E2E_API_PORT:-3004} nx run web-e2e-suite:e2e",
    "test:all": "pnpm test && pnpm test:int && pnpm test:e2e:api && pnpm test:e2e:ui",
    "ci:queue": "bash scripts/ci-queue.sh",
    "ci:check": "bash scripts/ci-check.sh",
    "test:coverage": "vitest run --project unit-node --project unit-dom --coverage",
    "test:security-mutations": "pnpx tsx scripts/security-mutations.ts",
    "test:check-integration": "bash scripts/ci-check-integration-mocks.sh",
    "test:check-dates": "bash scripts/ci-check-date-format.sh",
    "test:check-skips": "bash scripts/ci-check-skips.sh",
    "check:no-double-cast": "pnpx tsx scripts/check-no-double-cast.ts",
    "check:live-views": "pnpx tsx scripts/check-live-views.ts",
    "check:live-views-coverage": "pnpx tsx scripts/check-live-views-coverage.ts",
    "check:testids": "pnpx tsx scripts/check-testid-literals.ts",
    "check:field-help": "pnpx tsx scripts/check-field-help.ts",
    "check:form-errors": "pnpx tsx scripts/check-form-errors.ts",
    "help:ack": "pnpx tsx scripts/help-ack.ts",
    "check:rls-coverage": "pnpx tsx scripts/check-rls-coverage.ts",
    "check:tenant-foreign-keys": "pnpx tsx scripts/check-tenant-foreign-keys.ts",
    "check:select-columns": "pnpx tsx scripts/check-select-columns.ts",
    "check:synthetic-context-usage": "pnpx tsx scripts/check-synthetic-context-usage.ts",
    "check:admin-context-reach": "pnpx tsx scripts/check-admin-context-reach.ts",
    "check:direct-nats-emit": "pnpx tsx scripts/check-direct-nats-emit.ts",
    "check:store-keys": "pnpx tsx scripts/check-store-keys.ts",
    "check:log-messages": "pnpx tsx scripts/check-log-messages.ts",
    "check:audit": "pnpx tsx scripts/check-audit.ts",
    "check:service-db-access": "pnpx tsx scripts/check-service-db-access.ts",
    "check:event-handlers": "pnpx tsx scripts/check-event-handlers.ts",
    "check:docs": "pnpx tsx scripts/check-docs.ts",
    "check:codegen-drift": "pnpx tsx scripts/check-codegen-drift.ts",
    "check:jetstream-drift": ". scripts/instance-env.sh && pnpx tsx scripts/check-jetstream-drift.ts",
    "check:migration-chain": "pnpx tsx scripts/check-migration-chain.ts",
    "check:migrations": "pnpx tsx scripts/check-migrations.ts",
    "check:db-drift": "ROVIQ_EE=true DATABASE_URL=postgresql://x/x DATABASE_URL_MIGRATE=postgresql://x/x pnpm --filter @roviq/database exec drizzle-kit check --config=drizzle.config.ts",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "nx run-many -t build",
    "typecheck:watch": "scripts/typecheck-watch.sh",
    "deps:check": "pnpx tsx scripts/deps-check.ts",
    "deps:update": "pnpx tsx scripts/deps-update.ts",
    "deps:upgrade": "pnpx tsx scripts/deps-upgrade.ts",
    "dev:gateway": ". scripts/instance-env.sh && . scripts/dev-telemetry-env.sh && NODE_ENV=${NODE_ENV:-development} SWC_NODE_PROJECT=apps/api-gateway/tsconfig.app.json node --env-file-if-exists=.env --watch --watch-preserve-output --inspect=${API_GATEWAY_INSPECT_PORT:-9229} --trace-warnings -r @swc-node/register -r ./scripts/dev-ts-resolve.ts -r ./libs/backend/telemetry/src/init-telemetry.ts apps/api-gateway/src/main.ts",
    "dev:web": "scripts/dev-web.sh",
    "dev:web:e2e": ". scripts/instance-env.sh && cd apps/web && E2E_PROBE=1 NEXT_PUBLIC_API_URL=http://localhost:${E2E_API_PORT:-3004} pnpm exec next build && E2E_PROBE=1 NEXT_PUBLIC_API_URL=http://localhost:${E2E_API_PORT:-3004} pnpm exec next start -p ${E2E_WEB_PORT:-4201} --hostname 0.0.0.0",
    "dev:notifications": ". scripts/instance-env.sh && . scripts/dev-telemetry-env.sh && NODE_ENV=${NODE_ENV:-development} OTEL_SERVICE_NAME=notification-service SWC_NODE_PROJECT=apps/notification-service/tsconfig.app.json node --env-file-if-exists=.env --watch --watch-preserve-output --inspect=${NOTIFICATION_SERVICE_INSPECT_PORT:-9230} --trace-warnings -r @swc-node/register -r ./scripts/dev-ts-resolve.ts -r ./libs/backend/telemetry/src/init-telemetry.ts apps/notification-service/src/main.ts",
    "dev:docker": "docker compose -f docker/compose.dev.yaml up --watch",
    "dev:docker:build": "docker compose -f docker/compose.dev.yaml up --watch --build",
    "dev:docker:down": "docker compose -f docker/compose.dev.yaml down",
    "infra:up": "docker compose -f docker/compose.infra.yaml up -d",
    "infra:down": "docker compose -f docker/compose.infra.yaml down",
    "db:migrate": "nx run database:db:migrate",
    "db:generate": "nx run database:db:generate",
    "db:seed": "pnpx tsx scripts/seed-demo.ts",
    "db:seed:essential": "pnpx tsx scripts/seed-essential.ts",
    "admin:create": "pnpx tsx scripts/create-platform-admin.ts",
    "db:seed:demo": "pnpx tsx scripts/seed-demo.ts",
    "db:seed:e2e": "pnpx tsx scripts/seed-e2e.ts",
    "db:reset": "pnpx tsx scripts/db-reset.ts",
    "storage:init": "pnpx tsx scripts/storage-init.ts",
    "observability:load": ". scripts/instance-env.sh && pnpx tsx scripts/observability-load.ts",
    "storage:check": "pnpx tsx scripts/storage-check.ts",
    "storage:configure": "pnpx tsx scripts/storage-configure.ts",
    "db:studio": "nx run database:db:studio",
    "e2e:up": "scripts/e2e-compose.sh up -d --build --wait --remove-orphans",
    "e2e:clean": "scripts/e2e-compose.sh run --rm --no-deps migrate-and-seed",
    "e2e:down": "scripts/e2e-compose.sh --profile setup --profile vitest --profile rls down --remove-orphans",
    "e2e:nuke": "scripts/e2e-compose.sh --profile setup --profile vitest --profile rls down -v --remove-orphans && rm -rf .e2e",
    "instance:new": "pnpx tsx scripts/dev-instance.ts new",
    "instance:env": "pnpx tsx scripts/dev-instance.ts env",
    "instance:ports": "pnpx tsx scripts/dev-instance.ts ports",
    "tilt": ". scripts/instance-env.sh && tilt",
    "codegen": ". scripts/instance-env.sh && graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "prepare": "husky"
  },
