{
  "name": "api-gateway-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "e2e/api-gateway-e2e",
  "projectType": "application",
  "implicitDependencies": ["api-gateway"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project e2e-api"
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "inputs": ["e2eBackend"],
      "options": {
        "command": "vitest run --config e2e/api-gateway-e2e/vitest.config.ts"
      }
    },
    "e2e:vitest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm e2e:up && scripts/e2e-compose.sh run --rm vitest-e2e"
      }
    },
    "e2e:rls": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm e2e:up && scripts/e2e-compose.sh run --rm rls-tests"
      }
    },
    "e2e:all": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm e2e:up && scripts/e2e-compose.sh run --rm rls-tests && scripts/e2e-compose.sh run --rm vitest-e2e"
      }
    },
    "e2e:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm e2e:nuke"
      }
    }
  },
  "tags": ["e2e"]
}
