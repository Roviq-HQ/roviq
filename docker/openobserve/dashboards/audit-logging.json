{
  "version": 5,
  "title": "Roviq: audit logging",
  "description": "Audit pipeline: events published and consumed, consumer lag, dead letters and impersonation.",
  "tabs": [
    {
      "tabId": "default",
      "name": "Default",
      "panels": [
        {
          "id": "panel_1",
          "type": "line",
          "title": "Audit event throughput",
          "description": "Events per second published by the interceptor and written by the consumer.",
          "config": {
            "show_legends": true,
            "legends_position": "bottom",
            "drilldown": []
          },
          "queryType": "promql",
          "queries": [
            {
              "query": "sum by (scope) (rate(audit_events_published_total[5m]))",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "",
                "stream_type": "metrics",
                "x": [],
                "y": [],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "published {scope}"
              }
            },
            {
              "query": "sum(rate(audit_events_consumed_total[5m]))",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "",
                "stream_type": "metrics",
                "x": [],
                "y": [],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "consumed"
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 64,
            "h": 16,
            "i": 1
          }
        },
