{
  "name": "notification_sender_blocked",
  "description": "A WhatsApp sender's status is BLOCKED: the provider refused a send with WA_SENDER_BLOCKED. Nothing is sent through that number until a platform admin reactivates it; the alert clears then.",
  "stream_type": "metrics",
  "stream_name": "notification_sender_blocked",
  "is_real_time": false,
  "enabled": true,
  "query_condition": {
    "type": "promql",
    "promql": "max by (channel) (notification_sender_blocked)",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0
    }
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "frequency_type": "minutes",
    "silence": 60
  },
  "pending_period_sec": 0,
  "destinations": ["roviq_ops_email"],
  "context_attributes": {
    "severity": "page",
    "component": "notifications",
    "runbook": "docs/runbooks/notification-delivery.md#sender-blocked"
  }
}
