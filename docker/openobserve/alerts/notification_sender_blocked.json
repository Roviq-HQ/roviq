{
  "name": "notification_sender_blocked",
  "description": "The provider refused a send because the sender or the account is blocked (WA_SENDER_BLOCKED or SMS_SENDER_BLOCKED). That channel sends nothing until it is cleared.",
  "stream_type": "metrics",
  "stream_name": "notification_delivery",
  "is_real_time": false,
  "enabled": true,
  "query_condition": {
    "type": "promql",
    "promql": "sum by (channel, reason) (increase(notification_delivery{reason=~\"WA_SENDER_BLOCKED|SMS_SENDER_BLOCKED\"}[5m]))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0
    }
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "frequency_type": "minutes",
    "silence": 60
  },
  "pending_period_sec": 0,
  "destinations": ["roviq_ops_email"],
  "context_attributes": {
    "severity": "page",
    "component": "notifications",
    "runbook": "docs/runbooks/notification-delivery.md#sender-blocked"
  }
}
