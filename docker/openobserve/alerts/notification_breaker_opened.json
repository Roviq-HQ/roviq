{
  "name": "notification_breaker_opened",
  "description": "A provider or a WhatsApp sender kept failing (or was blocked) and its circuit breaker opened. Sends through it are held for a minute at a time and retried; nothing is lost, but nothing goes out through it either.",
  "stream_type": "metrics",
  "stream_name": "notification_breaker_opened",
  "is_real_time": false,
  "enabled": true,
  "query_condition": {
    "type": "promql",
    "promql": "sum by (channel, provider, reason) (increase(notification_breaker_opened[5m]))",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0
    }
  },
  "trigger_condition": {
    "period": 5,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "frequency_type": "minutes",
    "silence": 30
  },
  "pending_period_sec": 0,
  "destinations": ["roviq_ops_email"],
  "context_attributes": {
    "severity": "page",
    "component": "notifications",
    "runbook": "docs/runbooks/notification-delivery.md#breaker-opened"
  }
}
