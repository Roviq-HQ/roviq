{
  "name": "audit_dlq_depth",
  "description": "Audit events were dead-lettered: audit rows may be missing. Check the audit consumer logs and the Dead Letter Queue tab.",
  "stream_type": "metrics",
  "stream_name": "audit_events_dlq_total",
  "is_real_time": false,
  "enabled": true,
  "query_condition": {
    "type": "promql",
    "promql": "sum(audit_events_dlq_total)",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0
    }
  },
  "trigger_condition": {
    "period": 1,
    "operator": ">=",
    "threshold": 1,
    "frequency": 1,
    "frequency_type": "minutes",
    "silence": 30
  },
  "pending_period_sec": 60,
  "destinations": ["roviq_ops_email"],
  "context_attributes": {
    "severity": "critical",
    "component": "audit",
    "runbook": "docs/runbooks/audit-alerts.md#dead-lettered-audit-events"
  }
}
