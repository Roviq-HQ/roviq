# node:24-slim, pinned by digest so a rebuild gets the image that was tested. To move it:
#   docker buildx imagetools inspect node:24-slim
ARG NODE_IMAGE=node:24-slim@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530

# ── Base: install dependencies ───────────────────────────────
# Use slim (Debian) for parity with Dockerfile.backend, even though @temporalio/core-bridge
# is not used by web. corepack-managed pnpm reads version from packageManager field.
FROM ${NODE_IMAGE} AS base
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV COREPACK_HOME="/app/.corepack"
RUN corepack enable

COPY pnpm-lock.yaml ./
COPY package.json ./tmp-package.json
# pnpm-lock.yaml names patches/*.patch; the install reads them.
COPY patches ./patches
RUN node -e " \
  const pkg = require('./tmp-package.json'); \
  const keep = { name: pkg.name, version: pkg.version, packageManager: pkg.packageManager, \
    dependencies: pkg.dependencies, devDependencies: pkg.devDependencies, \
    peerDependencies: pkg.peerDependencies, pnpm: pkg.pnpm, \
    optionalDependencies: pkg.optionalDependencies, overrides: pkg.overrides }; \
  require('fs').writeFileSync('package.json', JSON.stringify(keep, null, 2));" \
  && rm tmp-package.json \
  && corepack install

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY package.json ./

# ── Build: production artifacts ──────────────────────────────
FROM base AS build

COPY . .
ENV STANDALONE=true
# CI=true makes codegen read from the committed schema.graphql instead of trying
# to introspect a running gateway. See codegen.ts SCHEMA_SOURCE selector.
ENV CI=true
RUN pnpm codegen
# NEXT_PUBLIC_* values are compiled into the browser bundle, so they are build arguments, not
# run-time settings. An argument that is not passed stays undefined and the app's default applies.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_INSTITUTE_URL
ARG NEXT_PUBLIC_ROVIQ_EE
ARG NEXT_PUBLIC_OPENOBSERVE_URL
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_VAPID_KEY
RUN pnpm nx run web:build --skip-nx-cache

# ── Production: web ───────────────────────────────────────────
FROM ${NODE_IMAGE} AS web

WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public

USER node
EXPOSE 4200
ENV PORT=4200
CMD ["node", "apps/web/server.js"]
