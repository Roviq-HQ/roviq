# Docker-internal environment variables
# Service hostnames resolve to Docker Compose service names

# Database — PostgreSQL connections
# DATABASE_URL — application runtime (roviq_app, non-superuser, RLS enforced)
DATABASE_URL=postgresql://roviq_app:roviq_app_dev@postgres:5432/roviq
# DATABASE_URL_ADMIN — admin operations (roviq_admin, policy-based RLS bypass)
DATABASE_URL_ADMIN=postgresql://roviq_admin:roviq_admin_dev@postgres:5432/roviq
# DATABASE_URL_MIGRATE — migrations only (roviq superuser, schema changes)
DATABASE_URL_MIGRATE=postgresql://roviq:roviq_dev@postgres:5432/roviq

# Redis
REDIS_URL=redis://redis:6379

# NATS
NATS_URL=nats://nats:4222

# JWT — access token signing key
JWT_SECRET=change-me-in-real-env
# JWT_REFRESH_SECRET — must differ from JWT_SECRET
JWT_REFRESH_SECRET=change-me-in-real-env
# JWT_EXPIRATION — access token TTL (e.g. 15m)
JWT_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION — refresh token TTL (e.g. 7d)
JWT_REFRESH_EXPIRATION=7d

# Object storage (S3-compatible; MinIO in dev). Two buckets, split by visibility.
# S3_ENDPOINT — endpoint the server uses
S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT — endpoint the browser can reach; presigned URLs are signed for it
S3_PUBLIC_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY=roviq_minio
S3_SECRET_KEY=roviq_minio_dev
# S3_BUCKET_PRIVATE — files that need a signed URL (documents, photos, exports)
S3_BUCKET_PRIVATE=roviq-private
# S3_BUCKET_PUBLIC — files readable without sign-in (institute and reseller branding)
S3_BUCKET_PUBLIC=roviq-public
# S3_PUBLIC_BASE_URL — stable base URL of the public bucket (a CDN in production)
S3_PUBLIC_BASE_URL=http://localhost:9002/roviq-public

# Temporal — workflow engine (host:port)
TEMPORAL_ADDRESS=temporal:7233

# WebAuthn — passkey configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Roviq

# CORS — allowed origins for API requests
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
